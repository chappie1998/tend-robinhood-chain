# Never commit a funded mainnet key.
# Set both chain selectors together. Unknown values or differing selections fail the build.
TEND_CHAIN=robinhood
VITE_CHAIN=robinhood
# TendPriceOracle is admin-controlled. Production mode refuses signing.
TEND_MODE=demo
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
PRIVATE_KEY=
NEXT_PUBLIC_TEND_MARKET_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=46630

# Monad testnet deploy key (see README-monad.md). Fund via https://faucet.monad.xyz.
# Never commit a funded key.
MONAD_DEPLOYER_KEY=

# Quote-signing service (quote-service/). The private key of the pool's
# quoteAuthority — for the testnet demo this is the SAME value as
# MONAD_DEPLOYER_KEY. Held server-side only; never expose it to the browser.
# Never commit a funded key. See quote-service/README.md.
QUOTE_AUTHORITY_KEY=
# Optional overrides (defaults shown): service port and the allowed CORS origin
# (the Vite dev server). QUOTE_SERVICE_ALLOWED_ORIGIN must match where the SPA runs.
# QUOTE_SERVICE_PORT=8787
# QUOTE_SERVICE_ALLOWED_ORIGIN=http://localhost:5173

# Licensed display data for NVDA, TSLA, and QQQ charts. Never used as the settlement oracle.
MASSIVE_API_KEY=

# Active demo market data comes from Coinbase Exchange public APIs: no data key needed.
# Optional, retained only for canonical Pyth / fork diagnostics:
PYTH_API_KEY=
# DEMO_ORIGIN=http://localhost:5173
