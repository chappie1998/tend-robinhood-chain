{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/pitch", "destination": "/pitch.html" },
    { "source": "/((?!api/|pitch).*)", "destination": "/index.html" }
  ]
}
