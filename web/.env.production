# Production build only. In the single-project Vercel deployment the SPA and the
# quote-signing serverless function are served from the SAME origin, so the SPA
# calls the function at the relative path /api. web/src/lib/quoteService.ts
# composes `${VITE_QUOTE_SERVICE_URL}/quote`, which here resolves to /api/quote.
#
# There is NO secret here — only a same-origin path. The signing key lives in
# the Vercel env var QUOTE_AUTHORITY_KEY (server-side only) and is never exposed
# to the browser. The dev default stays http://localhost:8787 (see .env.example).
VITE_QUOTE_SERVICE_URL=/api
